@model InventoryManagement.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Panel";
}

<h2 class="mt-4 mb-4">Genel Bakış</h2>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card text-white bg-primary h-100">
            <div class="card-body">
                <div class="small">Kategoriler</div>
                <div class="fs-2 fw-bold">@Model.CategoryCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card text-white bg-info h-100">
            <div class="card-body">
                <div class="small">Ürünler</div>
                <div class="fs-2 fw-bold">@Model.ProductCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card text-dark bg-warning h-100">
            <div class="card-body">
                <div class="small">Düşük Stok</div>
                <div class="fs-2 fw-bold">@Model.LowStockCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card text-white bg-danger h-100">
            <div class="card-body">
                <div class="small">Stok Tükendi</div>
                <div class="fs-2 fw-bold">@Model.OutOfStockCount</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Son Eklenen Ürünler</h5>
                @if (Model.RecentProducts.Count == 0)
                {
                    <p class="text-muted">Henüz ürün yok.</p>
                }
                else
                {
                    <table class="table table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Ürün</th>
                                <th>SKU</th>
                                <th class="text-end">Fiyat</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.RecentProducts)
                            {
                                <tr>
                                    <td>@product.Name</td>
                                    <td>@product.Sku</td>
                                    <td class="text-end">@product.Price.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Kritik Stok Durumu</h5>
                @if (Model.CriticalStocks.Count == 0)
                {
                    <p class="text-muted">Kritik stok yok.</p>
                }
                else
                {
                    <table class="table table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Ürün</th>
                                <th class="text-end">Miktar</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stock in Model.CriticalStocks)
                            {
                                <tr>
                                    <td>@stock.Product?.Name</td>
                                    <td class="text-end">@stock.Quantity</td>
                                    <td>@await Html.PartialAsync("_StockStatusBadge", stock.Status)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
