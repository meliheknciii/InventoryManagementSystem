@model InventoryManagement.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Panel";
}

@if (Model.ApiUnavailable)
{
    <div class="alert alert-warning mt-4" role="alert">
        <i class="bi bi-plug-fill me-2"></i>
        Backend API'ye ulaşılamadı. Verilerin görüntülenebilmesi için <strong>InventoryManagement.API</strong> projesinin çalışıyor olması gerekir.
    </div>
}

<div class="pt-4">
    <h2 class="page-title mb-4"><i class="bi bi-speedometer2 me-2"></i>Genel Bakış</h2>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card stat-card bg-categories h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-uppercase">Kategoriler</div>
                        <div class="fs-2 fw-bold">@Model.CategoryCount</div>
                    </div>
                    <i class="bi bi-tags-fill stat-icon"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card stat-card bg-products h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-uppercase">Ürünler</div>
                        <div class="fs-2 fw-bold">@Model.ProductCount</div>
                    </div>
                    <i class="bi bi-box2-fill stat-icon"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card stat-card bg-low-stock h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-uppercase">Düşük Stok</div>
                        <div class="fs-2 fw-bold">@Model.LowStockCount</div>
                    </div>
                    <i class="bi bi-exclamation-triangle-fill stat-icon"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card stat-card bg-out-of-stock h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-uppercase">Stok Tükendi</div>
                        <div class="fs-2 fw-bold">@Model.OutOfStockCount</div>
                    </div>
                    <i class="bi bi-x-octagon-fill stat-icon"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="content-card h-100">
                <h5 class="mb-3"><i class="bi bi-clock-history me-2"></i>Son Eklenen Ürünler</h5>
                @if (Model.RecentProducts.Count == 0)
                {
                    <div class="empty-state"><i class="bi bi-inbox display-6 d-block mb-2"></i>Henüz ürün yok.</div>
                }
                else
                {
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Ürün</th>
                                <th>SKU</th>
                                <th class="text-end">Fiyat</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.RecentProducts)
                            {
                                <tr>
                                    <td>@product.Name</td>
                                    <td><span class="badge bg-light text-dark border">@product.Sku</span></td>
                                    <td class="text-end">@product.Price.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
        <div class="col-lg-6">
            <div class="content-card h-100">
                <h5 class="mb-3"><i class="bi bi-exclamation-diamond-fill me-2"></i>Kritik Stok Durumu</h5>
                @if (Model.CriticalStocks.Count == 0)
                {
                    <div class="empty-state"><i class="bi bi-check2-circle display-6 d-block mb-2"></i>Kritik stok yok.</div>
                }
                else
                {
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Ürün</th>
                                <th class="text-end">Miktar</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stock in Model.CriticalStocks)
                            {
                                <tr>
                                    <td>@stock.ProductName</td>
                                    <td class="text-end">@stock.Quantity</td>
                                    <td>@await Html.PartialAsync("_StockStatusBadge", stock.Status)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
