@model InventoryManagement.Web.Models.StockStatus

@{
    // Stok durumuna göre farklı renkte bir Bootstrap badge (etiket) gösteriyoruz.
    string cssClass;
    string text;

    switch (Model)
    {
        case InventoryManagement.Web.Models.StockStatus.InStock:
            cssClass = "bg-success";
            text = "Stokta";
            break;
        case InventoryManagement.Web.Models.StockStatus.LowStock:
            cssClass = "bg-warning text-dark";
            text = "Az Stok";
            break;
        default:
            cssClass = "bg-danger";
            text = "Tükendi";
            break;
    }
}

<span class="badge @cssClass">@text</span>
