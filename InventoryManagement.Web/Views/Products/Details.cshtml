@model InventoryManagement.Web.Models.ProductViewModel
@{
    ViewData["Title"] = "Ürün Detayı";
}

<div class="pt-4 mb-4 d-flex justify-content-between align-items-center">
    <h2 class="page-title mb-0"><i class="bi bi-box2-fill me-2"></i>@Model.Name</h2>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-pencil-square me-1"></i>Düzenle
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
    </div>
</div>

<div class="content-card" style="max-width: 720px;">
    <dl class="row mb-0">
        <dt class="col-sm-3">SKU</dt>
        <dd class="col-sm-9"><span class="badge bg-light text-dark border">@Model.Sku</span></dd>

        <dt class="col-sm-3">Kategori</dt>
        <dd class="col-sm-9">@(Model.CategoryName ?? "-")</dd>

        <dt class="col-sm-3">Fiyat</dt>
        <dd class="col-sm-9">@Model.Price.ToString("C")</dd>

        <dt class="col-sm-3">Açıklama</dt>
        <dd class="col-sm-9">@(Model.Description ?? "-")</dd>
    </dl>
</div>
