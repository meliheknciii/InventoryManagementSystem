@model InventoryManagement.Web.Models.Product
@{
    ViewData["Title"] = "Ürün Detayı";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2>@Model.Name</h2>
    <div>
        <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-outline-primary">Düzenle</a>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Listeye Dön</a>
    </div>
</div>

<dl class="row" style="max-width: 700px;">
    <dt class="col-sm-3">SKU</dt>
    <dd class="col-sm-9">@Model.Sku</dd>

    <dt class="col-sm-3">Kategori</dt>
    <dd class="col-sm-9">@(Model.Category?.Name ?? "-")</dd>

    <dt class="col-sm-3">Fiyat</dt>
    <dd class="col-sm-9">@Model.Price.ToString("C")</dd>

    <dt class="col-sm-3">Açıklama</dt>
    <dd class="col-sm-9">@(Model.Description ?? "-")</dd>

    <dt class="col-sm-3">Stok Miktarı</dt>
    <dd class="col-sm-9">@(Model.Stock?.Quantity.ToString() ?? "Stok kaydı yok")</dd>
</dl>
