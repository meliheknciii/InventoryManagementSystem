@model InventoryManagement.Web.Models.ProductFormViewModel
@{
    ViewData["Title"] = "Ürün Düzenle";
}

<div class="pt-4 mb-4">
    <h2 class="page-title"><i class="bi bi-pencil-square me-2"></i>Ürün Düzenle</h2>
</div>

<div class="content-card" style="max-width: 720px;">
    <form asp-action="Edit" asp-route-id="@ViewBag.ProductId" method="post">
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <div class="row">
            <div class="col-md-8 mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Sku" class="form-label"></label>
                <input asp-for="Sku" class="form-control" />
                <span asp-validation-for="Sku" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Price" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">₺</span>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" />
                </div>
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" class="form-select" asp-items="Model.CategoryOptions">
                    <option value="">-- Kategori Seçiniz --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Güncelle</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
