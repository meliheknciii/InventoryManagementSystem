@model InventoryManagement.Web.Models.ProductFormViewModel
@{
    ViewData["Title"] = "Ürün Düzenle";
}

<h2 class="mt-4 mb-3">Ürün Düzenle</h2>

<div style="max-width: 700px;">
    <form action="@Url.Action("Edit", new { id = ViewBag.ProductId })" method="post">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <div class="row">
            <div class="col-md-8 mb-3">
                <label for="Name" class="form-label">Ürün Adı</label>
                <input type="text" id="Name" name="Name" class="form-control" value="@Model.Name" />
                @if (ViewData.ModelState["Name"]?.Errors.Count > 0)
                {
                    <div class="text-danger">@ViewData.ModelState["Name"]!.Errors[0].ErrorMessage</div>
                }
            </div>
            <div class="col-md-4 mb-3">
                <label for="Sku" class="form-label">SKU</label>
                <input type="text" id="Sku" name="Sku" class="form-control" value="@Model.Sku" />
                @if (ViewData.ModelState["Sku"]?.Errors.Count > 0)
                {
                    <div class="text-danger">@ViewData.ModelState["Sku"]!.Errors[0].ErrorMessage</div>
                }
            </div>
        </div>

        <div class="mb-3">
            <label for="Description" class="form-label">Açıklama</label>
            <textarea id="Description" name="Description" class="form-control" rows="3">@Model.Description</textarea>
            @if (ViewData.ModelState["Description"]?.Errors.Count > 0)
            {
                <div class="text-danger">@ViewData.ModelState["Description"]!.Errors[0].ErrorMessage</div>
            }
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="Price" class="form-label">Fiyat</label>
                <input type="number" id="Price" name="Price" class="form-control" step="0.01" min="0.01" value="@Model.Price" />
                @if (ViewData.ModelState["Price"]?.Errors.Count > 0)
                {
                    <div class="text-danger">@ViewData.ModelState["Price"]!.Errors[0].ErrorMessage</div>
                }
            </div>
            <div class="col-md-6 mb-3">
                <label for="CategoryId" class="form-label">Kategori</label>
                <select id="CategoryId" name="CategoryId" class="form-select">
                    <option value="">-- Kategori Seçiniz --</option>
                    @foreach (var option in Model.CategoryOptions)
                    {
                        @if (option.Selected)
                        {
                            <option value="@option.Value" selected="selected">@option.Text</option>
                        }
                        else
                        {
                            <option value="@option.Value">@option.Text</option>
                        }
                    }
                </select>
                @if (ViewData.ModelState["CategoryId"]?.Errors.Count > 0)
                {
                    <div class="text-danger">@ViewData.ModelState["CategoryId"]!.Errors[0].ErrorMessage</div>
                }
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Güncelle</button>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Vazgeç</a>
    </form>
</div>
