@model List<InventoryManagement.Web.Models.Product>
@{
    ViewData["Title"] = "Ürünler";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2>Ürünler</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary">Yeni Ürün</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">Henüz ürün eklenmemiş.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Ürün</th>
                <th>SKU</th>
                <th>Kategori</th>
                <th class="text-end">Fiyat</th>
                <th class="text-end">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Sku</td>
                    <td>@(product.Category?.Name ?? "-")</td>
                    <td class="text-end">@product.Price.ToString("C")</td>
                    <td class="text-end">
                        <a href="@Url.Action("Details", new { id = product.Id })" class="btn btn-sm btn-outline-secondary">Detay</a>
                        <a href="@Url.Action("Edit", new { id = product.Id })" class="btn btn-sm btn-outline-primary">Düzenle</a>
                        <form action="@Url.Action("Delete", new { id = product.Id })" method="post" class="d-inline"
                              onsubmit="return confirm('\'@product.Name\' ürününü silmek istediğinize emin misiniz?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
