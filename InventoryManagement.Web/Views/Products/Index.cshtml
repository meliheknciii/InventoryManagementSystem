@model List<InventoryManagement.Web.Models.ProductViewModel>
@{
    ViewData["Title"] = "Ürünler";
}

<div class="pt-4 d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title mb-0"><i class="bi bi-box2-fill me-2"></i>Ürünler</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Yeni Ürün
    </a>
</div>

<div class="content-card">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-box2 display-6 d-block mb-2"></i>
            Henüz ürün eklenmemiş.
        </div>
    }
    else
    {
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Ürün</th>
                    <th>SKU</th>
                    <th>Kategori</th>
                    <th class="text-end">Fiyat</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td class="fw-semibold">@product.Name</td>
                        <td><span class="badge bg-light text-dark border">@product.Sku</span></td>
                        <td>@(product.CategoryName ?? "-")</td>
                        <td class="text-end">@product.Price.ToString("C")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('\'@product.Name\' ürününü silmek istediğinize emin misiniz?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
