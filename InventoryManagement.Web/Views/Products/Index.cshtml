@model InventoryManagement.Web.Models.ProductListViewModel
@{
    ViewData["Title"] = "Ürünler";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2>Ürünler</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary">Yeni Ürün</a>
</div>

@* 
    Arama ve filtreleme formu.
    method="get" kullanıyoruz çünkü veri değiştirmiyoruz, sadece listeyi filtreliyoruz.
    Bu sayede filtre değerleri URL'e query string olarak eklenir (örn: ?searchTerm=kalem&categoryId=2)
    ve sayfa yenilense/paylaşılsa bile filtre korunur.
*@
<form action="@Url.Action("Index")" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-5">
        <label for="searchTerm" class="form-label">Ara</label>
        <input type="text" id="searchTerm" name="searchTerm" value="@Model.SearchTerm"
               class="form-control" placeholder="Ürün adı veya SKU..." />
    </div>
    <div class="col-md-4">
        <label for="categoryId" class="form-label">Kategori</label>
        <select id="categoryId" name="categoryId" class="form-select">
            @* 
                "Tüm Kategoriler" seçeneği, categoryId hiç seçilmediğinde (null) işaretli kalır.
                Not: HTML'de "selected" bir boolean attribute'tur; sadece VAR OLMASI yeterlidir,
                değeri (true/false yazması) önemli değildir. Bu yüzden selected="@(...)" yazmak
                YANLIŞTIR (her zaman seçili görünür). Bunun yerine if/else ile attribute'u
                tamamen var etmeli ya da hiç yazmamalıyız.
            *@
            @if (Model.CategoryId is null)
            {
                <option value="" selected="selected">Tüm Kategoriler</option>
            }
            else
            {
                <option value="">Tüm Kategoriler</option>
            }

            @* 
                Controller'da BuildCategoryOptions() metodu ile hazırlanan liste burada döngüye alınıyor.
                Her kategori için bir <option> etiketi oluşturuyoruz.
                Seçili olan kategoriye "selected" özelliğini ekliyoruz ki filtre uygulandıktan sonra
                kullanıcı hangi kategoriyi seçtiğini dropdown'da görebilsin.
            *@
            @foreach (var category in Model.CategoryOptions)
            {
                @if (category.Selected)
                {
                    <option value="@category.Value" selected="selected">@category.Text</option>
                }
                else
                {
                    <option value="@category.Value">@category.Text</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Filtrele</button>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Temizle</a>
    </div>
</form>

@if (Model.Products.Count == 0)
{
    <p class="text-muted">Aramanıza uygun ürün bulunamadı.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Ürün</th>
                <th>SKU</th>
                <th>Kategori</th>
                <th class="text-end">Fiyat</th>
                <th class="text-end">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Sku</td>
                    <td>@(product.Category?.Name ?? "-")</td>
                    <td class="text-end">@product.Price.ToString("C")</td>
                    <td class="text-end">
                        <a href="@Url.Action("Details", new { id = product.Id })" class="btn btn-sm btn-outline-secondary">Detay</a>
                        <a href="@Url.Action("Edit", new { id = product.Id })" class="btn btn-sm btn-outline-primary">Düzenle</a>
                        <form action="@Url.Action("Delete", new { id = product.Id })" method="post" class="d-inline"
                              onsubmit="return confirm('\'@product.Name\' ürününü silmek istediğinize emin misiniz?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @*
        Sayfalama (Pagination) alanı.
        Arama kutusu ve kategori filtresini de linke ekliyoruz ki sayfa değiştirince
        filtreler kaybolmasın. Sadece 1'den fazla sayfa varsa gösteriyoruz.
    *@
    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">
                @* Önceki sayfa butonu *@
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { searchTerm = Model.SearchTerm, categoryId = Model.CategoryId, page = Model.PageNumber - 1 })">Önceki</a>
                </li>

                @* Sayfa numaraları (1, 2, 3, ...) *@
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { searchTerm = Model.SearchTerm, categoryId = Model.CategoryId, page = i })">@i</a>
                    </li>
                }

                @* Sonraki sayfa butonu *@
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { searchTerm = Model.SearchTerm, categoryId = Model.CategoryId, page = Model.PageNumber + 1 })">Sonraki</a>
                </li>
            </ul>
        </nav>

        <p class="text-center text-muted">
            Toplam @Model.TotalCount ürün, sayfa @Model.PageNumber / @Model.TotalPages
        </p>
    }
}
