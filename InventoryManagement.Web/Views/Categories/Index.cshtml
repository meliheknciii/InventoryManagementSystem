@model List<InventoryManagement.Web.Models.Category>
@{
    ViewData["Title"] = "Kategoriler";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2>Kategoriler</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary">Yeni Kategori</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">Henüz kategori eklenmemiş.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Ad</th>
                <th>Açıklama</th>
                <th class="text-end">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@(category.Description ?? "-")</td>
                    <td class="text-end">
                        <a href="@Url.Action("Edit", new { id = category.Id })" class="btn btn-sm btn-outline-primary">Düzenle</a>
                        <form action="@Url.Action("Delete", new { id = category.Id })" method="post" class="d-inline"
                              onsubmit="return confirm('\'@category.Name\' kategorisini silmek istediğinize emin misiniz?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
