@model List<InventoryManagement.Web.Models.CategoryViewModel>
@{
    ViewData["Title"] = "Kategoriler";
}

<div class="pt-4 d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title mb-0"><i class="bi bi-tags-fill me-2"></i>Kategoriler</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Yeni Kategori
    </a>
</div>

<div class="content-card">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-tags display-6 d-block mb-2"></i>
            Henüz kategori eklenmemiş.
        </div>
    }
    else
    {
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Ad</th>
                    <th>Açıklama</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td class="fw-semibold">@category.Name</td>
                        <td class="text-muted">@(category.Description ?? "-")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('\'@category.Name\' kategorisini silmek istediğinize emin misiniz?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
