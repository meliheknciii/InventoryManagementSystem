@model InventoryManagement.Web.Models.StockFormViewModel
@{
    ViewData["Title"] = "Yeni Stok Kaydı";
}

<h2 class="mt-4 mb-3">Yeni Stok Kaydı</h2>

<div style="max-width: 600px;">
    <form action="@Url.Action("Create")" method="post">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <div class="mb-3">
            <label for="ProductId" class="form-label">Ürün</label>
            <select id="ProductId" name="ProductId" class="form-select">
                <option value="">-- Ürün Seçiniz --</option>
                @foreach (var option in Model.ProductOptions)
                {
                    @if (option.Selected)
                    {
                        <option value="@option.Value" selected="selected">@option.Text</option>
                    }
                    else
                    {
                        <option value="@option.Value">@option.Text</option>
                    }
                }
            </select>
            @if (ViewData.ModelState["ProductId"]?.Errors.Count > 0)
            {
                <div class="text-danger">@ViewData.ModelState["ProductId"]!.Errors[0].ErrorMessage</div>
            }
        </div>

        <div class="mb-3">
            <label for="Quantity" class="form-label">Miktar</label>
            <input type="number" id="Quantity" name="Quantity" class="form-control" min="0" value="@Model.Quantity" />
            @if (ViewData.ModelState["Quantity"]?.Errors.Count > 0)
            {
                <div class="text-danger">@ViewData.ModelState["Quantity"]!.Errors[0].ErrorMessage</div>
            }
        </div>

        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Vazgeç</a>
    </form>
</div>
