@model InventoryManagement.Web.Models.StockFormViewModel
@{
    ViewData["Title"] = "Yeni Stok Kaydı";
}

<div class="pt-4 mb-4">
    <h2 class="page-title"><i class="bi bi-plus-circle-fill me-2"></i>Yeni Stok Kaydı</h2>
</div>

<div class="content-card" style="max-width: 640px;">
    <form asp-action="Create" method="post">
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <div class="mb-3">
            <label asp-for="ProductId" class="form-label"></label>
            <select asp-for="ProductId" class="form-select" asp-items="Model.ProductOptions">
                <option value="">-- Ürün Seçiniz --</option>
            </select>
            <span asp-validation-for="ProductId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Quantity" class="form-label"></label>
            <input asp-for="Quantity" class="form-control" type="number" min="0" />
            <span asp-validation-for="Quantity" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Kaydet</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
