@model InventoryManagement.Web.Models.StockFormViewModel
@{
    ViewData["Title"] = "Stok Düzenle";
}

<h2 class="mt-4 mb-3">Stok Düzenle</h2>

<div style="max-width: 600px;">
    <form action="@Url.Action("Edit", new { id = ViewBag.StockId })" method="post">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <div class="mb-3">
            <label class="form-label">Ürün</label>
            <input type="text" class="form-control" value="@ViewBag.ProductName" disabled />
            <input type="hidden" name="ProductId" value="@Model.ProductId" />
        </div>

        <div class="mb-3">
            <label for="Quantity" class="form-label">Miktar</label>
            <input type="number" id="Quantity" name="Quantity" class="form-control" min="0" value="@Model.Quantity" />
            @if (ViewData.ModelState["Quantity"]?.Errors.Count > 0)
            {
                <div class="text-danger">@ViewData.ModelState["Quantity"]!.Errors[0].ErrorMessage</div>
            }
        </div>

        <button type="submit" class="btn btn-primary">Güncelle</button>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Vazgeç</a>
    </form>
</div>
