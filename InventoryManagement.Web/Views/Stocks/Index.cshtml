@model List<InventoryManagement.Web.Models.StockViewModel>
@{
    ViewData["Title"] = "Stoklar";
}

<div class="pt-4 d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title mb-0"><i class="bi bi-clipboard-data-fill me-2"></i>Stoklar</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Yeni Stok Kaydı
    </a>
</div>

<div class="content-card">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-clipboard-x display-6 d-block mb-2"></i>
            Henüz stok kaydı yok.
        </div>
    }
    else
    {
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Ürün</th>
                    <th class="text-end">Miktar</th>
                    <th>Durum</th>
                    <th>Son Güncelleme</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var stock in Model)
                {
                    <tr>
                        <td class="fw-semibold">@(stock.ProductName ?? "-")</td>
                        <td class="text-end">@stock.Quantity</td>
                        <td>@await Html.PartialAsync("_StockStatusBadge", stock.Status)</td>
                        <td class="text-muted">@stock.LastUpdatedUtc.ToLocalTime().ToString("g")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@stock.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@stock.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Bu stok kaydını silmek istediğinize emin misiniz?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
