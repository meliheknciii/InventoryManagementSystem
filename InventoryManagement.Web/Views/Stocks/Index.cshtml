@model List<InventoryManagement.Web.Models.Stock>
@{
    ViewData["Title"] = "Stoklar";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2>Stoklar</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary">Yeni Stok Kaydı</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">Henüz stok kaydı yok.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Ürün</th>
                <th class="text-end">Miktar</th>
                <th>Durum</th>
                <th>Son Güncelleme</th>
                <th class="text-end">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var stock in Model)
            {
                <tr>
                    <td>@(stock.Product?.Name ?? "-")</td>
                    <td class="text-end">@stock.Quantity</td>
                    <td>@await Html.PartialAsync("_StockStatusBadge", stock.Status)</td>
                    <td>@stock.LastUpdatedUtc.ToLocalTime().ToString("g")</td>
                    <td class="text-end">
                        <a href="@Url.Action("Edit", new { id = stock.Id })" class="btn btn-sm btn-outline-primary">Düzenle</a>
                        <form action="@Url.Action("Delete", new { id = stock.Id })" method="post" class="d-inline"
                              onsubmit="return confirm('Bu stok kaydını silmek istediğinize emin misiniz?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
